{
  "name": "blank-discord",
  "version": "1.0.0",
  "description": "Discord.js integration for the Blank publishing API — embeds, attachments, and markdown helpers.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["blank", "discord", "discord.js", "embed", "publishing", "bot"],
  "author": "it-sBlank",
  "license": "MIT",
  "dependencies": {
    "blank-api": "^1.0.0"
  },
  "peerDependencies": {
    "discord.js": ">=14.0.0"
  },
  "devDependencies": {
    "discord.js": "^14.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
